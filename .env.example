# --- API ---
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_API_URL=https://jeniffer-unavenging-centrodorsally.ngrok-free.dev/api/v1/

# --- RevenueCat ---
# From RevenueCat dashboard → Project Settings → API Keys → "Apple App Store" (public key,
# starts with "appl_"). Safe to expose client-side — it's a public key, not the secret one.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# From the same page → "Google Play" (starts with "goog_"), once Android IAP is set up.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
