{
  "expo": {
    "name": "Elite Scope",
    "slug": "sample",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/elite-scope-icon.png",
    "scheme": "sample",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#03070F",
        "foregroundImage": "./assets/images/elite-scope-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.thimmy.sample"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/elite-scope-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03070F",
          "image": "./assets/images/elite-scope-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c25474d9-b7be-4b70-ab9c-b694866662f3"
      }
    }
  }
}
